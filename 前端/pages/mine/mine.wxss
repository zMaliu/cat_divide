page {
  background-color: #F7F8FC;
}

.mine-container {
  min-height: 100vh;
  padding-bottom: 20rpx;
}

/* 个人信息卡片 */
.profile-card {
  background-color: #F6EFE4;
  margin: 20rpx 30rpx;
  border-radius: 24rpx;
  padding: 40rpx 30rpx 30rpx;
  box-shadow: 0 6rpx 20rpx rgba(54, 29, 30, 0.08);
}

.profile-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 40rpx;
}

.profile-left {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  border: 4rpx solid #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(54, 29, 30, 0.1);
}

.user-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding-top: 10rpx;
}

.nickname {
  font-size: 36rpx;
  font-weight: 700;
  color: #361D1E;
  line-height: 1.2;
}

.intro {
  font-size: 26rpx;
  color: #666;
  opacity: 0.8;
}

.love-level {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  padding-top: 10rpx;
}

.level-text {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.level-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #F8633B;
}

.profile-content {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.stats-section {
  display: flex;
  gap: 40rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  cursor: pointer;
  transition: transform 0.2s ease;
}

.stat-item:active {
  transform: scale(0.95);
}

.stat-number {
  font-size: 32rpx;
  font-weight: 700;
  color: #361D1E;
  line-height: 1.2;
}

.stat-label {
  font-size: 24rpx;
  color: #666;
  margin-top: 4rpx;
}

.action-buttons {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.follow-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 20rpx;
  background: linear-gradient(135deg, #F8633B, #F86331);
  border-radius: 20rpx;
  transition: all 0.3s ease;
  min-width: 80rpx;
}

.follow-btn:active {
  transform: scale(0.95);
}

.follow-text {
  font-size: 22rpx;
  color: white;
  font-weight: 600;
}

.follow-count {
  font-size: 20rpx;
  color: white;
  opacity: 0.9;
  margin-top: 2rpx;
}

.icon-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: white;
  border-radius: 50%;
  box-shadow: 0 4rpx 8rpx rgba(54, 29, 30, 0.1);
  transition: all 0.3s ease;
}

.icon-btn:active {
  transform: scale(0.9);
}

.icon {
  font-size: 28rpx;
}

/* 内容标签栏 */
.content-tabs {
  display: flex;
  background-color: white;
  margin: 20rpx 30rpx 0;
  border-radius: 16rpx;
  padding: 8rpx;
  box-shadow: 0 4rpx 12rpx rgba(54, 29, 30, 0.05);
  position: relative;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 10rpx;
  position: relative;
  transition: all 0.3s ease;
}

.tab-item.active {
  background-color: rgba(248, 99, 59, 0.08);
  border-radius: 12rpx;
}

.tab-text {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
  transition: color 0.3s ease;
}

.tab-item.active .tab-text {
  color: #F8633B;
  font-weight: 600;
}

.tab-indicator {
  position: absolute;
  bottom: 8rpx;
  width: 32rpx;
  height: 4rpx;
  background: linear-gradient(90deg, #F8633B, #F86331);
  border-radius: 2rpx;
}

/* 喜欢内容头部 */
.like-content-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
  background-color: white;
  position: relative;
}

.content-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #361D1E;
}

.dropdown-container {
  position: relative;
}

/* 下拉按钮 */
.dropdown-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background-color: rgba(248, 99, 59, 0.1);
  border-radius: 20rpx;
  transition: all 0.3s ease;
  border: 2rpx solid transparent;
}

.dropdown-btn:active {
  transform: scale(0.95);
  background-color: rgba(248, 99, 59, 0.15);
  border-color: rgba(248, 99, 59, 0.3);
}

.dropdown-text {
  font-size: 24rpx;
  color: #F8633B;
  font-weight: 500;
}

.dropdown-arrow {
  font-size: 18rpx;
  color: #F8633B;
  transition: transform 0.3s ease;
}

.dropdown-arrow.rotate {
  transform: rotate(180deg);
}

.dropdown-menu {
  position: absolute;
  top: 60rpx;
  right: 0;
  background-color: white;
  border-radius: 12rpx;
  box-shadow: 0 8rpx 24rpx rgba(54, 29, 30, 0.15);
  z-index: 100;
  overflow: hidden;
  min-width: 120rpx;
}

.dropdown-item {
  padding: 24rpx 30rpx;
  font-size: 26rpx;
  color: #666;
  transition: all 0.3s ease;
  border-bottom: 1rpx solid #f5f5f5;
  text-align: center;
}

.dropdown-item:last-child {
  border-bottom: none;
}

.dropdown-item.selected {
  color: #F8633B;
  background-color: rgba(248, 99, 59, 0.05);
  font-weight: 600;
}

.dropdown-item:active {
  background-color: rgba(248, 99, 59, 0.08);
}

/* 内容区域 */
.content-area {
  margin: 20rpx 30rpx;
  min-height: 400rpx;
}

.tab-content {
  background-color: white;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(54, 29, 30, 0.05);
}

/* 发布内容样式 */
.publish-header {
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.publish-btn {
  width: 100%;
  height: 80rpx;
  background: linear-gradient(135deg, #F8633B, #F86331);
  color: white;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 16rpx;
  border: none;
  box-shadow: 0 6rpx 16rpx rgba(248, 99, 59, 0.3);
  transition: all 0.3s ease;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 0;
  margin: 0;
  line-height: normal;
}

.publish-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(248, 99, 59, 0.4);
}

.post-grid {
  padding: 20rpx;
}

.post-item {
  display: flex;
  padding: 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
  transition: all 0.3s ease;
}

.post-item:active {
  background-color: #fafafa;
}

.post-item:last-child {
  border-bottom: none;
}

.post-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
}

.post-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.post-title {
  font-size: 28rpx;
  color: #361D1E;
  font-weight: 500;
  line-height: 1.4;
  margin-bottom: 12rpx;
}

.post-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.like-count {
  font-size: 24rpx;
  color: #F8633B;
}

.post-time {
  font-size: 22rpx;
  color: #999;
}

/* 喜欢的内容样式 */
.post-list {
  padding: 20rpx 30rpx;
}

.liked-post {
  display: flex;
  padding: 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
  transition: all 0.3s ease;
}

.liked-post:active {
  background-color: #fafafa;
}

.liked-post:last-child {
  border-bottom: none;
}

.post-thumb {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
}

.post-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.post-author {
  font-size: 22rpx;
  color: #F8633B;
}

/* 记录样式 */
.record-section {
  margin-bottom: 40rpx;
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #361D1E;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
  background-color: #fafafa;
}

.record-list {
  padding: 20rpx 30rpx;
}

.record-item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f8f8f8;
}

.record-item:last-child {
  border-bottom: none;
}

.record-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.record-text {
  font-size: 26rpx;
  color: #361D1E;
  line-height: 1.4;
}

.record-author {
  font-size: 22rpx;
  color: #F8633B;
}

.record-time {
  font-size: 22rpx;
  color: #999;
  margin-left: 20rpx;
}

/* 收藏样式 */
.collection-list {
  padding: 20rpx 30rpx;
}

.collection-item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f8f8f8;
}

.collection-item:last-child {
  border-bottom: none;
}

.collection-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.collection-title {
  font-size: 28rpx;
  color: #361D1E;
  font-weight: 500;
}

.collection-type {
  font-size: 22rpx;
  color: #F8633B;
  background-color: rgba(248, 99, 59, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  align-self: flex-start;
}

.collection-time {
  font-size: 22rpx;
  color: #999;
  margin-left: 20rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 400rpx;
  background-color: white;
  border-radius: 16rpx;
}

.empty-icon {
  font-size: 120rpx;
  opacity: 0.3;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}