
.container {
    padding: 0;
    background-color: #f8f8f8;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  
  .header {
    text-align: center;
    padding: 30rpx 20rpx 20rpx;
    background-color: #fff;
    border-bottom: 1rpx solid #eee;
  }
  
  .title {
    font-size: 36rpx;
    font-weight: bold;
    color: #333;
    display: block;
    margin-bottom: 15rpx;
  }
  
  .subtitle {
    font-size: 26rpx;
    color: #666;
    line-height: 1.4;
  }
  
  .camera-section {
    background-color: #fff;
    margin: 20rpx;
    border-radius: 16rpx;
    overflow: hidden;
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  }
  
  .camera-container {
    position: relative;
    width: 100%;
    height: 400rpx;
    background-color: #000;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2rpx solid #fff;
  }
  
  .camera-placeholder {
    width: 100%;
    height: 100%;
    background-color: #000;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .camera-icon {
    width: 80rpx;
    height: 80rpx;
    opacity: 0.3;
  }
  
  .button-group {
    display: flex;
    justify-content: space-between;
    padding: 30rpx 20rpx;
    gap: 20rpx;
  }
  
  .button-group button {
    flex: 1;
    height: 80rpx;
    border-radius: 40rpx;
    font-size: 28rpx;
    font-weight: 500;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .retake-btn {
    background-color: #f0f0f0;
    color: #07c160;
    border: 2rpx solid #07c160;
  }
  
  .identify-btn {
    background-color: #07c160;
    color: #fff;
  }
  
  .identify-btn:active {
    background-color: #06ad56;
  }
  
  .result-section {
    background-color: #fff;
    margin: 20rpx;
    border-radius: 16rpx;
    padding: 30rpx;
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  }
  
  .result-card {
    padding: 0;
  }
  
  .result-title {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
    display: block;
    margin-bottom: 20rpx;
    text-align: center;
  }
  
  .breed-info {
    margin-bottom: 30rpx;
  }
  
  .breed-name {
    font-size: 30rpx;
    color: #333;
    display: block;
    margin-bottom: 10rpx;
    font-weight: 600;
  }
  
  .confidence {
    font-size: 26rpx;
    color: #666;
    margin-bottom: 15rpx;
  }
  
  .breed-description {
    background-color: #f8f8f8;
    padding: 20rpx;
    border-radius: 12rpx;
    border-left: 4rpx solid #07c160;
  }
  
  .description-title {
    font-size: 28rpx;
    color: #333;
    font-weight: bold;
    display: block;
    margin-bottom: 10rpx;
  }
  
  .description-content {
    font-size: 26rpx;
    color: #666;
    line-height: 1.6;
  }
  
  /* 加载状态 */
  .loading-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 60rpx 20rpx;
  }
  
  .loading-icon {
    width: 60rpx;
    height: 60rpx;
    margin-bottom: 20rpx;
  }
  
  .loading-text {
    font-size: 28rpx;
    color: #666;
  }
  
  /* 错误状态 */
  .error-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 60rpx 20rpx;
  }
  
  .error-icon {
    width: 80rpx;
    height: 80rpx;
    margin-bottom: 20rpx;
    opacity: 0.5;
  }
  
  .error-text {
    font-size: 28rpx;
    color: #999;
    text-align: center;
  }
  
  /* 响应式设计 */
  @media (max-width: 750rpx) {
    .camera-container {
      height: 350rpx;
    }
    
    .button-group {
      padding: 25rpx 15rpx;
    }
    
    .button-group button {
      height: 70rpx;
      font-size: 26rpx;
    }
  }