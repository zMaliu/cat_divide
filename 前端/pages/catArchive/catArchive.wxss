page {
  background: #F6EFE4;
}

.archive-page {
  padding: 20rpx 30rpx 40rpx;
  color: #361D1E;
}

.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  position: relative;
}

.top-bar .primary-btn {
  position: absolute;
  right: 0;
}

.title-box {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
}

.subtitle {
  font-size: 24rpx;
  color: #8c6f66;
}

.search-box {
  position: relative;
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(54, 29, 30, 0.08);
}

.search-input {
  width: 100%;
  background: #F8F3EC;
  border-radius: 14rpx;
  padding: 16rpx 50rpx 16rpx 16rpx;
  font-size: 26rpx;
  color: #361D1E;
  box-sizing: border-box;
  text-align: left;
  line-height: normal;
  height: auto;
  min-height: 60rpx;
  display: block;
}

.search-clear {
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #A18F87;
  background: #F8F3EC;
  border-radius: 50%;
}

.primary-btn {
  background: linear-gradient(135deg, #FFB84D, #F8633B);
  color: #fff;
  border: none;
  padding: 0 26rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  box-shadow: 0 8rpx 20rpx rgba(248, 99, 59, 0.25);
}

.state-box {
  background: #fff;
  border-radius: 20rpx;
  padding: 60rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(54, 29, 30, 0.08);
}

.spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid rgba(248, 99, 59, 0.1);
  border-top-color: #F8633B;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0); }
  100% { transform: rotate(360deg); }
}

.state-text {
  font-size: 26rpx;
  color: #664441;
}

.empty {
  background: linear-gradient(135deg, rgba(255, 184, 77, 0.08), rgba(248, 99, 59, 0.08));
}

.empty-icon {
  font-size: 80rpx;
}

.card-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 20rpx rgba(54, 29, 30, 0.08);
}

.card-img {
  width: 100%;
  height: 260rpx;
  display: block;
}

.card-body {
  padding: 20rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
}

.card-tag {
  font-size: 22rpx;
  color: #fff;
  background: #F8633B;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.card-time {
  font-size: 22rpx;
  color: #A18F87;
}

.card-sub {
  display: block;
  font-size: 24rpx;
  color: #664441;
  margin: 6rpx 0;
}

.card-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #513a35;
  line-height: 1.5;
}

.card-footer {
  margin-top: 12rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.owner {
  font-size: 22rpx;
  color: #A18F87;
}

.actions {
  display: flex;
  gap: 12rpx;
}

.mini-btn {
  padding: 0 16rpx;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
}

.mini-btn.warn {
  background: #ffeded;
  color: #e54646;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.35);
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 30rpx;
  z-index: 99;
}

.modal {
  width: 100%;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.15);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.modal-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #361D1E;
}

.modal-close {
  font-size: 32rpx;
  color: #A18F87;
}

.form-item {
  margin-top: 12rpx;
}

.label {
  display: block;
  font-size: 24rpx;
  color: #664441;
  margin-bottom: 6rpx;
}

.input, .textarea, .picker {
  width: 100%;
  background: #F8F3EC;
  border-radius: 14rpx;
  padding: 16rpx;
  font-size: 26rpx;
  color: #361D1E;
  box-sizing: border-box;
  text-align: left;
  line-height: normal;
  height: auto;
  min-height: 60rpx;
}

.textarea {
  min-height: 120rpx;
}

.form-actions {
  margin-top: 20rpx;
  display: flex;
  justify-content: flex-end;
  gap: 14rpx;
}

.btn {
  min-width: 160rpx;
  height: 70rpx;
  line-height: 70rpx;
  text-align: center;
  border-radius: 20rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn.plain {
  background: #F1E6DD;
  color: #664441;
}

.btn.primary {
  background: linear-gradient(135deg, #FFB84D, #F8633B);
  color: #fff;
  border: none;
}

.image-upload-section {
  margin-top: 10rpx;
}

.image-preview {
  position: relative;
  width: 100%;
  height: 300rpx;
  border-radius: 14rpx;
  overflow: hidden;
  background: #F8F3EC;
}

.preview-img {
  width: 100%;
  height: 100%;
}

.remove-img {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 50rpx;
  height: 50rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.upload-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: #F8F3EC;
  color: #664441;
  border: 2rpx dashed #A18F87;
  border-radius: 14rpx;
  font-size: 26rpx;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

.upload-tip {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #A18F87;
  text-align: center;
}

