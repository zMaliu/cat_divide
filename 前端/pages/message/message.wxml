<view class="container">
  <!-- 顶部标题 -->
  <view class="header">
    <text class="title">消息</text>
  </view>

  <!-- 消息列表 -->
  <view class="message-list" wx:if="{{messageList.length > 0}}">
    <view class="message-item" wx:for="{{messageList}}" wx:key="session_id" bindtap="onMessageTap" data-session="{{item}}">
      <!-- 用户头像 -->
      <view class="avatar-container">
        <image class="avatar" src="{{item.avatar || '/assets/default-avatar.png'}}" mode="aspectFill"></image>
        <view class="unread-badge" wx:if="{{item.unread_count > 0}}">{{item.unread_count}}</view>
      </view>
      
      <!-- 消息内容 -->
      <view class="message-content">
        <view class="message-header">
          <text class="username">{{item.other_user_name}}</text>
          <text class="time">{{item.updated_time}}</text>
        </view>
        <view class="message-preview">
          <text class="preview-text">{{item.last_message || '暂无消息'}}</text>
        </view>
      </view>
      
      <!-- 箭头 -->
      <view class="arrow">
        <text class="arrow-icon">></text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{messageList.length === 0}}">
    <image class="empty-icon" src="/assets/empty-message.png" mode="aspectFit"></image>
    <text class="empty-text">暂无消息</text>
    <text class="empty-desc">开始关注其他用户，就能收到消息了</text>
  </view>

  <!-- 加载更多 -->
  <view class="load-more" wx:if="{{hasMore}}">
    <text class="load-text" wx:if="{{!loading}}">上拉加载更多</text>
    <view class="loading" wx:if="{{loading}}">
      <text class="loading-text">加载中...</text>
    </view>
  </view>
</view>