/* 自定义导航栏 */
.custom-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 9999;
    background: #FFFFFF;
    border-bottom: 2rpx solid #F5F5F5;
  }
  
  .status-bar {
    height: var(--status-bar-height, 88rpx);
    background: #FFFFFF;
  }
  
  .nav-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 88rpx;
    padding: 0 60rpx;
  }
  
  .nav-left {
    display: flex;
    align-items: center;
    min-width: 120rpx;
  }
  
  .back-icon {
    font-size: 40rpx;
    font-weight: bold;
    color: #666666;
    margin-right: 8rpx;
  }
  
  .back-text {
    font-size: 28rpx;
    color: #666666;
  }
  
  .nav-title {
    font-size: 36rpx;
    font-weight: bold;
    color: #333333;
    flex: 1;
    text-align: center;
  }
  
  .nav-right {
    min-width: 120rpx;
  }
  
  /* 主要内容样式 */
  .login-form-container {
    width: 100%;
    min-height: 100vh;
    background: #FFFFFF;
