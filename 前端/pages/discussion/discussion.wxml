<view class="discussion-container">
  <!-- 顶部标题和排序 -->
  <view class="header">
    <text class="page-title">讨论</text>
    <view class="sort-container">
      <view class="sort-btn" bindtap="onSortDropdownToggle">
        <text class="sort-text">{{currentSort === 'hot' ? '按热度' : '按时间'}}</text>
        <text class="sort-arrow {{showSortDropdown ? 'rotate' : ''}}">▼</text>
      </view>
      <!-- 排序下拉菜单 -->
      <view class="sort-dropdown" wx:if="{{showSortDropdown}}">
        <view class="sort-item {{currentSort === 'hot' ? 'selected' : ''}}" 
              bindtap="onSortChange" 
              data-sort="hot">按热度</view>
        <view class="sort-item {{currentSort === 'time' ? 'selected' : ''}}" 
              bindtap="onSortChange" 
              data-sort="time">按时间</view>
      </view>
    </view>
  </view>

  <!-- 分类标签栏 -->
  <view class="category-tabs">
    <view class="tab-item {{activeCategory === item.key ? 'active' : ''}}" 
          wx:for="{{categories}}" 
          wx:key="key"
          bindtap="onCategoryChange" 
          data-category="{{item.key}}">
      <text class="tab-text">{{item.name}}</text>
      <view class="tab-indicator" wx:if="{{activeCategory === item.key}}"></view>
    </view>
  </view>

  <!-- 内容区域 -->
  <view class="content-area">
    <!-- 加载状态 -->
    <view class="loading-container" wx:if="{{isLoading}}">
      <view class="loading-spinner"></view>
      <text class="loading-text">加载中...</text>
    </view>

    <!-- 错误状态 -->
    <view class="error-container" wx:if="{{loadError && !isLoading}}">
      <text class="error-icon">⚠️</text>
      <text class="error-text">加载失败，请稍后重试</text>
      <button class="retry-btn" bindtap="loadDiscussions">重新加载</button>
    </view>

    <!-- 空状态 -->
    <view class="empty-container" wx:if="{{!isLoading && !loadError && discussions.length === 0}}">
      <text class="empty-icon">💬</text>
      <text class="empty-text">暂无讨论，快来发起第一个话题吧！</text>
      <button class="create-btn" bindtap="onNewDiscussion">发起讨论</button>
    </view>

    <!-- 讨论网格 -->
    <scroll-view 
      scroll-y="true" 
      class="discussion-scroll" 
      wx:if="{{!isLoading && !loadError && discussions.length > 0}}"
      refresher-enabled="{{true}}"
      refresher-threshold="{{80}}"
      refresher-triggered="{{false}}"
      bindrefresherrefresh="onPullDownRefresh"
      enhanced="true"
      bounces="true"
      show-scrollbar="{{false}}"
      bindscrolltolower="onReachBottom"
    >
      <view class="discussion-grid">
        <view class="discussion-card" 
              wx:for="{{discussions}}" 
              wx:key="article_id"
              bindtap="onDiscussionTap"
              data-discussion="{{item}}"
              data-index="{{index}}">
          
          <!-- 讨论图片 -->
          <image 
            src="{{item.imgUrl || item.img || '../../assets/demo1.jpg'}}" 
            class="discussion-img" 
            mode="aspectFill" 
            lazy-load="true" 
            bindload="onImageLoad" 
            binderror="onImageError"
            data-index="{{index}}"
          />
          
          <!-- 讨论内容 -->
          <view class="discussion-info">
            <text class="discussion-title">{{item.title}}</text>
            <text class="discussion-content">{{item.content}}</text>
            
            <view class="discussion-meta">
              <view class="author-info">
                <text class="author-name">{{item.author}}</text>
                <text class="post-time">{{item.time}}</text>
              </view>
            </view>
            
            <view class="discussion-actions">
              <view class="like-section" 
                    bindtap="toggleLike" 
                    data-post-id="{{item.article_id}}"
                    data-index="{{index}}"
                    catchtap="toggleLike">
                <text class="like-icon {{item.is_liked ? 'liked' : ''}}">❤️</text>
                <text class="like-count">{{item.like_count}}</text>
              </view>
              
              <view class="reply-section">
                <text class="reply-icon">💭</text>
                <text class="reply-count">{{item.reply_count}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
      
      <!-- 加载更多 -->
      <view class="loading-more" wx:if="{{isLoadingMore}}">
        <view class="loading-spinner small"></view>
        <text class="loading-more-text">加载更多...</text>
      </view>
      
      <!-- 已加载全部 -->
      <view class="no-more" wx:if="{{noMoreData && discussions.length > 0}}">
        <text class="no-more-text">已经到底啦~</text>
      </view>
    </scroll-view>
  </view>

  <!-- 悬浮发布按钮 -->
  <view class="fab" bindtap="onNewDiscussion">
    <text class="fab-icon">+</text>
  </view>
</view>
