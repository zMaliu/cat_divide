<view class="archive-page">
  <view class="top-bar">
    <view class="title-box">
      <text class="title">猫咪档案</text>
      <text class="subtitle">管理猫咪品种与信息</text>
    </view>
    <button class="primary-btn" bindtap="openCreate" size="mini">+ 新增</button>
  </view>

  <!-- 搜索框 -->
  <view class="search-box">
    <input 
      class="search-input" 
      placeholder="搜索品种，例如：英短、美短" 
      value="{{searchKeyword}}"
      bindinput="onSearchInput"
    />
    <view wx:if="{{searchKeyword}}" class="search-clear" bindtap="clearSearch">✕</view>
  </view>

  <view wx:if="{{isLoading}}" class="state-box">
    <view class="spinner"></view>
    <text class="state-text">加载中...</text>
  </view>

  <view wx:elif="{{filteredCats.length === 0 && !isLoading}}" class="state-box empty">
    <text class="empty-icon">🐾</text>
    <text class="state-text">{{searchKeyword ? '未找到相关品种的猫咪' : '暂无猫咪档案'}}</text>
    <button wx:if="{{!searchKeyword}}" class="primary-btn" bindtap="openCreate" size="mini">去添加</button>
  </view>

  <view wx:else class="card-list">
    <block wx:for="{{filteredCats}}" wx:key="cat_id">
      <view class="card">
        <image class="card-img" src="{{item.displayImage}}" mode="aspectFill" binderror="onCardImageError" data-index="{{index}}"></image>
        <view class="card-body">
          <view class="card-header">
            <view class="name-row">
              <text class="card-title">{{item.name}}</text>
              <text class="card-tag">{{item.genderLabel}}</text>
            </view>
            <text class="card-time">{{item.create_time || ''}}</text>
          </view>
          <text class="card-sub">品种：{{item.breed || '未填写'}}</text>
          <text class="card-sub">年龄：{{item.age !== null && item.age !== undefined ? item.age + ' 岁' : '未知'}}</text>
          <text class="card-desc">{{item.description || '暂无描述'}}</text>
          <view class="card-footer">
            <text class="owner">创建者：{{item.owner_name || '未知'}}</text>
            <view class="actions">
              <button wx:if="{{item.isOwner}}" class="mini-btn" size="mini" bindtap="openEdit" data-index="{{index}}">编辑</button>
              <button wx:if="{{item.isOwner}}" class="mini-btn warn" size="mini" type="warn" bindtap="confirmDelete" data-id="{{item.cat_id}}">删除</button>
            </view>
          </view>
        </view>
      </view>
    </block>
  </view>

  <!-- 弹窗表单 -->
  <view wx:if="{{showForm}}" class="modal-mask">
    <view class="modal" catchtouchmove="true">
      <view class="modal-header">
        <text class="modal-title">{{formMode === 'create' ? '新增猫咪' : '编辑猫咪'}}</text>
        <text class="modal-close" bindtap="closeForm">✕</text>
      </view>

      <view class="form-item">
        <text class="label">名字 *</text>
        <input class="input" placeholder="必填" value="{{form.name}}" data-field="name" bindinput="onInputChange" />
      </view>

      <view class="form-item">
        <text class="label">品种</text>
        <input class="input" placeholder="例如：英短、美短（可自动识别）" value="{{form.breed}}" data-field="breed" bindinput="onInputChange" />
      </view>

      <view class="form-item">
        <text class="label">年龄</text>
        <input class="input" type="number" placeholder="岁数，可留空" value="{{form.age}}" data-field="age" bindinput="onInputChange" />
      </view>

      <view class="form-item">
        <text class="label">性别</text>
        <picker mode="selector" range="{{genderOptions}}" value="{{genderIndex}}" bindchange="onGenderChange">
          <view class="picker">{{genderOptions[genderIndex]}}</view>
        </picker>
      </view>

      <view class="form-item">
        <text class="label">描述</text>
        <textarea class="textarea" placeholder="性格、特点等" value="{{form.description}}" data-field="description" bindinput="onInputChange"></textarea>
      </view>

      <view class="form-item">
        <text class="label">图片</text>
        <view class="image-upload-section">
          <view wx:if="{{form.image_url}}" class="image-preview">
            <image class="preview-img" src="{{form.image_url}}" mode="aspectFill" binderror="onImageError"></image>
            <view class="remove-img" bindtap="removeImage">✕</view>
          </view>
          <button wx:else class="upload-btn" bindtap="chooseImage">选择图片</button>
          <text class="upload-tip">点击选择图片，支持相册和拍照</text>
        </view>
      </view>

      <view class="form-actions">
        <button class="btn plain" bindtap="closeForm">取消</button>
        <button class="btn primary" bindtap="submitForm" loading="{{isSubmitting}}">{{formMode === 'create' ? '创建' : '保存'}}</button>
      </view>
    </view>
  </view>
</view>

