.splash-container {
  width: 100%;
  height: 100vh;
  background: linear-gradient(180deg, #FFA726 0%, #FF9800 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 120rpx 60rpx 80rpx 60rpx;
  box-sizing: border-box;
  position: relative;
}

.content-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.logo-container {
  margin-bottom: 60rpx;
}

.logo-icon {
  width: 200rpx;
  height: 200rpx;
  animation: logoFloat 2s ease-in-out infinite;
}

.app-name {
  font-size: 48rpx;
  font-weight: bold;
  color: #FFFFFF;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  letter-spacing: 4rpx;
}

.bottom-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  text-align: center;
  line-height: 1.5;
}

/* 图标浮动动画 */
@keyframes logoFloat {
  0%, 100% {
    transform: translateY(0rpx);
  }
  50% {
    transform: translateY(-20rpx);
  }
}

/* 页面进入动画 */
.splash-container {
  animation: fadeIn 0.5s ease-in;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
