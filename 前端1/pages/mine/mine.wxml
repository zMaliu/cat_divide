<view class="mine-container">
  <!-- 个人信息卡片 -->
  <view class="profile-card">
    <!-- 上半部分：头像、昵称、等级 -->
    <view class="profile-header">
      <view class="profile-left">
        <image class="avatar" src="{{userInfo.avatar}}" mode="aspectFill" bindtap="onAvatarTap"></image>
        <view class="user-info">
          <text class="nickname">{{userInfo.nickname}}</text>
          <text class="intro">{{userInfo.intro}}</text>
        </view>
      </view>
      <view class="love-level">
        <text class="level-text">爱心等级：</text>
        <text class="level-value">{{userInfo.loveLevel}}</text>
      </view>
    </view>

    <!-- 下半部分：统计数据和操作按钮 -->
    <view class="profile-content">
      <view class="stats-section">
        <view class="stat-item" bindtap="onStatsClick" data-type="发布帖子">
          <text class="stat-number">{{userInfo.postCount}}</text>
          <text class="stat-label">发布帖子</text>
        </view>
        <view class="stat-item" bindtap="onStatsClick" data-type="发布记录">
          <text class="stat-number">{{userInfo.recordCount}}</text>
          <text class="stat-label">发布记录</text>
        </view>
        <view class="stat-item" bindtap="onStatsClick" data-type="粉丝">
          <text class="stat-number">{{userInfo.fansCount}}</text>
          <text class="stat-label">粉丝</text>
        </view>
      </view>
      
      <view class="action-buttons">
        <view class="follow-btn" bindtap="onStatsClick" data-type="关注">
          <text class="follow-text">关注</text>
          <text class="follow-count">{{userInfo.followingCount}}</text>
        </view>
        <view class="icon-btn" bindtap="onSettings">
          <text class="icon">⚙️</text>
        </view>
        <view class="icon-btn" bindtap="onEditProfile">
          <text class="icon">✏️</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 内容标签栏 -->
  <view class="content-tabs">
    <view class="tab-item {{activeTab === 'publish' ? 'active' : ''}}" 
          bindtap="onTabChange" 
          data-tab="publish">
      <text class="tab-text">发布</text>
      <view class="tab-indicator" wx:if="{{activeTab === 'publish'}}"></view>
    </view>
    
    <view class="tab-item {{activeTab === 'like' ? 'active' : ''}}" 
          bindtap="onTabChange" 
          data-tab="like">
      <text class="tab-text">喜欢</text>
      <view class="tab-indicator" wx:if="{{activeTab === 'like'}}"></view>
    </view>
    
    <view class="tab-item {{activeTab === 'collect' ? 'active' : ''}}" 
          bindtap="onTabChange" 
          data-tab="collect">
      <text class="tab-text">收藏</text>
      <view class="tab-indicator" wx:if="{{activeTab === 'collect'}}"></view>
    </view>
  </view>

  <!-- 内容区域 -->
  <view class="content-area">
    
    <!-- 发布标签内容 -->
    <view class="tab-content" wx:if="{{activeTab === 'publish'}}">
      <view class="publish-header">
        <button class="publish-btn" bindtap="onPosting">📝 发布作品</button>
      </view>
      <view class="post-grid">
        <view class="post-item" 
              wx:for="{{publishedPosts}}" 
              wx:key="id"
              bindtap="onPostDetail"
              data-post="{{item}}">
          <image class="post-image" src="{{item.image}}" mode="aspectFill"></image>
          <view class="post-info">
            <text class="post-title">{{item.title}}</text>
            <view class="post-meta">
              <text class="like-count">❤️ {{item.likeCount}}</text>
              <text class="post-time">{{item.time}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 喜欢标签内容 -->
    <view class="tab-content" wx:if="{{activeTab === 'like'}}">
      
      <!-- 喜欢内容的头部，包含下拉选择器 -->
      <view class="like-content-header">
        <text class="content-title">我喜欢的{{likeSubTab === 'post' ? '帖子' : '记录'}}</text>
        <view class="dropdown-container">
          <!-- 下拉按钮 -->
          <view class="dropdown-btn" bindtap="onLikeDropdownToggle">
            <text class="dropdown-text">{{likeSubTab === 'post' ? '帖子' : '记录'}}</text>
            <text class="dropdown-arrow {{showLikeDropdown ? 'rotate' : ''}}">▼</text>
          </view>
          <!-- 下拉菜单 -->
          <view class="dropdown-menu" wx:if="{{showLikeDropdown}}">
            <view class="dropdown-item {{likeSubTab === 'post' ? 'selected' : ''}}" 
                  bindtap="onLikeSubTabChange" 
                  data-subtab="post">帖子</view>
            <view class="dropdown-item {{likeSubTab === 'record' ? 'selected' : ''}}" 
                  bindtap="onLikeSubTabChange" 
                  data-subtab="record">记录</view>
          </view>
        </view>
      </view>
      
      <!-- 喜欢的帖子 -->
      <view wx:if="{{likeSubTab === 'post'}}">
        <view class="post-list">
          <view class="liked-post" 
                wx:for="{{likedPosts}}" 
                wx:key="id"
                bindtap="onPostDetail"
                data-post="{{item}}">
            <image class="post-thumb" src="{{item.image}}" mode="aspectFill"></image>
            <view class="post-content">
              <text class="post-title">{{item.title}}</text>
              <text class="post-author">by {{item.author}}</text>
              <text class="post-time">{{item.time}}</text>
            </view>
          </view>
        </view>
      </view>
      
      <!-- 喜欢的记录 -->
      <view wx:if="{{likeSubTab === 'record'}}">
        <view class="record-section">
          <text class="section-title">投喂记录</text>
          <view class="record-list">
            <view class="record-item" wx:for="{{feedRecords}}" wx:key="id">
              <view class="record-content">
                <text class="record-text">{{item.content}}</text>
                <text class="record-author">by {{item.author}}</text>
              </view>
              <text class="record-time">{{item.time}}</text>
            </view>
          </view>
        </view>
        
        <view class="record-section">
          <text class="section-title">健康记录</text>
          <view class="record-list">
            <view class="record-item" wx:for="{{healthRecords}}" wx:key="id">
              <view class="record-content">
                <text class="record-text">{{item.content}}</text>
                <text class="record-author">by {{item.author}}</text>
              </view>
              <text class="record-time">{{item.time}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 收藏标签内容 -->
    <view class="tab-content" wx:if="{{activeTab === 'collect'}}">
      <view class="collection-list">
        <view class="collection-item" wx:for="{{collections}}" wx:key="id">
          <view class="collection-info">
            <text class="collection-title">{{item.title}}</text>
            <text class="collection-type">{{item.type}}</text>
          </view>
          <text class="collection-time">{{item.time}}</text>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{showEmptyState}}">
      <text class="empty-icon">📝</text>
      <text class="empty-text">暂无内容</text>
    </view>

  </view>
</view>