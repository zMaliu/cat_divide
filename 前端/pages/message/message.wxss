page {
    background-color: #F6EFE4;
    /* 性能优化 */
    contain: layout style paint;
  }

.container {
    background-color: #F6EFE4;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  
  
  /* 三个功能区域 */
  .function-section {
    display: flex;
    justify-content: space-around;
    padding: 30rpx 50rpx;
    background-color: #FFFFFF;
    margin: 0 30rpx 20rpx;
    border-radius: 20rpx;
    box-shadow: 0 4rpx 16rpx rgba(54, 29, 30, 0.08);
  }
  
  .function-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 20rpx;
    transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    border-radius: 16rpx;
    position: relative;
  }
  
  .function-item:active {
    transform: translateY(-2rpx) scale(0.95);
    background-color: rgba(255, 184, 77, 0.1);
  }
  
  .function-icon {
    width: 100rpx;
    height: 100rpx;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 40rpx;
    margin-bottom: 16rpx;
    box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.15);
    transition: all 0.3s ease;
    position: relative;
    background-color: #FFB84D;
    color: #FFFFFF;
  }
  
  .function-icon::before {
    content: '';
    position: absolute;
    top: -2rpx;
    left: -2rpx;
    right: -2rpx;
    bottom: -2rpx;
    border-radius: 50%;
    background: linear-gradient(45deg, rgba(255, 255, 255, 0.8), rgba(255, 255, 255, 0.2));
    z-index: -1;
  }
  
  .function-item:active .function-icon {
    transform: scale(0.9);
  }
  
  .function-text {
    font-size: 24rpx;
    color: #664441;
    font-weight: 500;
    text-align: center;
  }
  
  /* 消息列表 */
  .message-list {
    background-color: #F6EFE4;
    margin: 0;
    padding: 0;
    border-top: none;
    flex: 1;
  }
  
  .message-item {
    display: flex;
    align-items: center;
    padding: 24rpx 30rpx;
    border-bottom: 1rpx solid rgba(54, 29, 30, 0.08);
    background-color: #F6EFE4;
    width: 100%;
    box-sizing: border-box;
    transition: all 0.3s ease;
  }
  
  .message-item:last-child {
    border-bottom: none;
  }
  
  .message-item:active {
    background-color: rgba(255, 184, 77, 0.1);
  }
  
  /* 头像容器 */
  .avatar-container {
    position: relative;
    margin-right: 20rpx;
  }
  
  .avatar {
    width: 100rpx;
    height: 100rpx;
    border-radius: 50%;
    background-color: #f0f0f0;
  }
  
  .unread-badge {
    position: absolute;
    top: -5rpx;
    right: -5rpx;
    background-color: #ff4757;
    color: #fff;
    font-size: 20rpx;
    min-width: 32rpx;
    height: 32rpx;
    border-radius: 16rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 6rpx;
  }
  
  /* 消息内容 */
  .message-content {
    flex: 1;
    margin-right: 20rpx;
  }
  
  .message-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10rpx;
  }
  
  .username {
    font-size: 32rpx;
    color: #361D1E;
    font-weight: 600;
  }
  
  .time {
    font-size: 24rpx;
    color: #664441;
  }
  
  .message-preview {
    display: flex;
    align-items: center;
  }
  
  .preview-text {
    font-size: 28rpx;
    color: #664441;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 400rpx;
    line-height: 1.4;
  }
  
  /* 箭头 */
  .arrow {
    display: flex;
    align-items: center;
  }
  
  .arrow-icon {
    font-size: 24rpx;
    color: #664441;
    font-weight: 600;
  }
  
  /* 空状态 */
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 200rpx 30rpx;
    background-color: #F6EFE4;
  }
  
  .empty-icon {
    width: 200rpx;
    height: 200rpx;
    margin-bottom: 30rpx;
    opacity: 0.6;
  }
  
  .empty-text {
    font-size: 32rpx;
    color: #361D1E;
    margin-bottom: 10rpx;
    font-weight: 600;
  }
  
  .empty-desc {
    font-size: 26rpx;
    color: #664441;
    text-align: center;
    line-height: 1.5;
  }
  
  /* 加载更多 */
  .load-more {
    text-align: center;
    padding: 30rpx;
    background-color: #F6EFE4;
  }
  
  .load-text {
    font-size: 26rpx;
    color: #664441;
  }
  
  .loading {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .loading-text {
    font-size: 26rpx;
    color: #664441;
    margin-left: 10rpx;
  }
  
  /* 下拉刷新样式 */
  .refresh-container {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20rpx;
    background-color: #F6EFE4;
  }
  
  .refresh-text {
    font-size: 26rpx;
    color: #664441;
  } 