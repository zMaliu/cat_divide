    box-sizing: border-box;
  }
  
  .content-area {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 40rpx 60rpx 60rpx 60rpx;
  }
  
  .logo-container {
    margin-bottom: 80rpx;
  }
  
  .logo-icon {
    width: 160rpx;
    height: 160rpx;
  }
  
  .form-container {
    width: 100%;
    max-width: 500rpx;
  }
  
  .input-group {
    margin-bottom: 40rpx;
  }
  
  .form-input {
    width: 100%;
    height: 100rpx;
    padding: 0 32rpx;
    border: 3rpx solid #E8E8E8;
    border-radius: 16rpx;
    font-size: 30rpx;
    color: #333333;
    background: #FAFAFA;
    transition: all 0.3s ease;
    box-sizing: border-box;
  }
  
  .form-input:focus {
    border-color: #FF9800;
    background: #FFFFFF;
    box-shadow: 0 0 0 6rpx rgba(255, 152, 0, 0.1);
  }
  
  .input-placeholder {
    color: #CCCCCC;
    font-size: 30rpx;
  }
  
  .submit-btn {
    width: 100%;
    height: 100rpx;
    line-height: 100rpx;
    padding: 0;
    background: #FF9800;
    color: #FFFFFF;
    border: none;
    border-radius: 20rpx;
    font-size: 34rpx;
    font-weight: bold;
    margin-top: 40rpx;
    transition: all 0.3s ease;
    box-shadow: 0 8rpx 24rpx rgba(255, 152, 0, 0.3);
  }
  
  .submit-btn:active {
    transform: scale(0.98);
    background: #F57F17;
  }
  
  .submit-btn:disabled {
    background: #CCCCCC;
    color: #999999;
    box-shadow: none;
  }
  
  /* 页面进入动画 */
  .login-form-container {
    animation: slideInRight 0.3s ease-out;
  }
  
  @keyframes slideInRight {
    from {
      transform: translateX(100%);
      opacity: 0;
    }
    to {
      transform: translateX(0);
