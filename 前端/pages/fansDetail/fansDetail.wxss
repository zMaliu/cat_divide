.fans-container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 页面头部 */
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  margin-bottom: 20rpx;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.total-count {
  font-size: 28rpx;
  color: #666;
}

/* 粉丝列表 */
.fans-list {
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.fan-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1px solid #f0f0f0;
}

.fan-item:last-child {
  border-bottom: none;
}

.fan-info {
  display: flex;
  align-items: center;
  flex: 1;
}

.fan-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.fan-detail {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.fan-name {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.fan-bio {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.follow-time {
  font-size: 24rpx;
  color: #999;
}

/* 关注按钮 */
.follow-btn {
  width: 80rpx;
  height: 60rpx;
  line-height: 30rpx;
  font-size: 28rpx;
  border-radius: 30rpx;
  background-color: #07c160;
  color: #fff;
}

.follow-btn.followed {
  background-color: #f5f5f5;
  color: #666;
  border: 1px solid #e5e5e5;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 加载状态 */
.loading-state {
  text-align: center;
  padding: 50rpx 0;
  font-size: 28rpx;
  color: #666;
}